{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ENABLE_PCH": "OFF",
                "ENABLE_UNITY_BUILD": "OFF",
                "ENABLE_COMPILER_CACHE": "ON",
                "ARCADE_BUILD_EDITOR": "ON",
                "ARCADE_ENABLE_TRACY": "OFF",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug",
            "description": "Debug build with the editor and headless tests."
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release",
            "description": "Optimized build with the editor and headless tests."
        },
        {
            "name": "clang-tidy",
            "inherits": "base",
            "displayName": "Clang-Tidy",
            "cacheVariables": {
                "ENABLE_CLANG_TIDY": "ON",
                "ARCADE_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "AddressSanitizer",
            "condition": {
                "type": "matches",
                "string": "${hostSystemName}",
                "regex": "^(Linux|Darwin)$"
            },
            "cacheVariables": {
                "ENABLE_ASAN": "ON",
                "ARCADE_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "ubsan",
            "inherits": "base",
            "displayName": "UndefinedBehaviorSanitizer",
            "condition": {
                "type": "matches",
                "string": "${hostSystemName}",
                "regex": "^(Linux|Darwin)$"
            },
            "cacheVariables": {
                "ENABLE_UBSAN": "ON",
                "ARCADE_BUILD_EDITOR": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug", "configuration": "Debug", "jobs": 0 },
        { "name": "release", "configurePreset": "release", "configuration": "Release", "jobs": 0 },
        { "name": "clang-tidy", "configurePreset": "clang-tidy", "configuration": "Debug", "jobs": 0 },
        { "name": "asan", "configurePreset": "asan", "configuration": "Debug", "jobs": 0 },
        { "name": "ubsan", "configurePreset": "ubsan", "configuration": "Debug", "jobs": 0 }
    ]
}
